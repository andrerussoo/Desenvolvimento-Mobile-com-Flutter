// TELA PRINCIPAL E NAVEGAÇÃO
class Inicio extends StatefulWidget {
  const Inicio({super.key});

  @override
  State<Inicio> createState() => _InicioState();
}

class _InicioState extends State<Inicio> {
  int paginaSelecionada = 0;
  final Set<String> favoritos = {};
  String termoPesquisa = '';

  void alterarFavorito(Receita receita) {
    setState(() {
      if (favoritos.contains(receita.nome)) {
        favoritos.remove(receita.nome);
      } else {
        favoritos.add(receita.nome);
      }
    });
  }

  void pesquisar(String termo) {
    final consulta = termo.trim();

    if (consulta.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Digite o nome de uma receita para pesquisar.'),
        ),
      );
      return;
    }

    setState(() {
      termoPesquisa = consulta;
      paginaSelecionada = 2;
    });
  }

  void abrirReceita(Receita receita) {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (context) => DetalhesReceita(
          receita: receita,
          favorito: favoritos.contains(receita.nome),
          onFavoritar: () => alterarFavorito(receita),
        ),
      ),
    ).then((_) {
      setState(() {});
    });
  }

  @override
  Widget build(BuildContext context) {
    final telas = [
      TelaInicio(
        onPesquisar: pesquisar,
        onAbrirReceita: abrirReceita,
        favoritos: favoritos,
        onFavoritar: alterarFavorito,
      ),
      TelaFavoritos(
        favoritos: favoritos,
        onAbrirReceita: abrirReceita,
        onFavoritar: alterarFavorito,
      ),
      TelaReceitas(
        termoInicial: termoPesquisa,
        favoritos: favoritos,
        onAbrirReceita: abrirReceita,
        onFavoritar: alterarFavorito,
      ),
      const TelaPerfil(),
    ];

    return Scaffold(
      body: IndexedStack(
        index: paginaSelecionada,
        children: telas,
      ),
      bottomNavigationBar: NavigationBar(
        selectedIndex: paginaSelecionada,
        onDestinationSelected: (index) {
          setState(() {
            paginaSelecionada = index;
          });
        },
        destinations: const [
          NavigationDestination(
            icon: Icon(Icons.home_outlined),
            selectedIcon: Icon(Icons.home),
            label: 'Início',
          ),
          NavigationDestination(
            icon: Icon(Icons.favorite_border),
            selectedIcon: Icon(Icons.favorite),
            label: 'Favoritos',
          ),
          NavigationDestination(
            icon: Icon(Icons.menu_book_outlined),
            selectedIcon: Icon(Icons.menu_book),
            label: 'Receitas',
          ),
          NavigationDestination(
            icon: Icon(Icons.person_outline),
            selectedIcon: Icon(Icons.person),
            label: 'Perfil',
          ),
        ],
      ),
    );
  }
}

