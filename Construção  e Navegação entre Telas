// TELA DE RECEITAS
class TelaReceitas extends StatefulWidget {
  final String termoInicial;
  final Set<String> favoritos;
  final Function(Receita) onAbrirReceita;
  final Function(Receita) onFavoritar;

  const TelaReceitas({
    super.key,
    required this.termoInicial,
    required this.favoritos,
    required this.onAbrirReceita,
    required this.onFavoritar,
  });

  @override
  State<TelaReceitas> createState() => _TelaReceitasState();
}

class _TelaReceitasState extends State<TelaReceitas> {
  late TextEditingController controller;
  String termo = '';
  String categoriaSelecionada = 'Todas';
  String? erro;

  final List<String> categorias = [
    'Todas',
    'Café da manhã',
    'Almoço',
    'Jantar',
    'Sobremesas',
    'Lanches',
  ];

  @override
  void initState() {
    super.initState();
    termo = widget.termoInicial;
    controller = TextEditingController(text: termo);
  }

  @override
  void didUpdateWidget(covariant TelaReceitas oldWidget) {
    super.didUpdateWidget(oldWidget);

    if (oldWidget.termoInicial != widget.termoInicial) {
      termo = widget.termoInicial;
      controller.text = termo;
    }
  }

  @override
  void dispose() {
    controller.dispose();
    super.dispose();
  }

  void pesquisar() {
    final consulta = controller.text.trim();

    setState(() {
      if (consulta.isEmpty) {
        erro = 'Digite o nome de uma receita para pesquisar.';
        termo = '';
      } else {
        termo = consulta;
        erro = null;
      }
    });
  }

  @override
  Widget build(BuildContext context) {
    final listaFiltrada = receitas.where((receita) {
      final correspondeNome = receita.nome
          .toLowerCase()
          .contains(termo.toLowerCase());

      final correspondeCategoria =
          categoriaSelecionada == 'Todas' ||
              receita.categoria == categoriaSelecionada;

      return correspondeNome && correspondeCategoria;
    }).toList();

    return SafeArea(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            tituloPagina(
              'Todas as receitas',
              'Encontre sua próxima receita favorita.',
            ),

            TextField(
              controller: controller,
              textInputAction: TextInputAction.search,
              onSubmitted: (_) => pesquisar(),
              decoration: InputDecoration(
                hintText: 'Nome da receita...',
                prefixIcon: const Icon(Icons.search),
                suffixIcon: IconButton(
                  icon: const Icon(Icons.close),
                  onPressed: () {
                    controller.clear();
                    setState(() {
                      termo = '';
                      erro = null;
                    });
                  },
                ),
                filled: true,
                fillColor: Colors.white,
                border: OutlineInputBorder(
                  borderRadius: BorderRadius.circular(15),
                  borderSide: BorderSide.none,
                ),
              ),
            ),

            const SizedBox(height: 8),

            SizedBox(
              width: double.infinity,
              child: ElevatedButton(
                onPressed: pesquisar,
                style: ElevatedButton.styleFrom(
                  backgroundColor: azul,
                  foregroundColor: Colors.white,
                ),
                child: const Text('Pesquisar'),
              ),
            ),

            if (erro != null)
              Padding(
                padding: const EdgeInsets.only(top: 8),
                child: Text(
                  erro!,
                  style: const TextStyle(color: Colors.red),
                ),
              ),

            const SizedBox(height: 15),

            SizedBox(
              height: 42,
              child: ListView(
                scrollDirection: Axis.horizontal,
                children: categorias.map((categoria) {
                  return Padding(
                    padding: const EdgeInsets.only(right: 8),
                    child: ChoiceChip(
                      label: Text(categoria),
                      selected: categoriaSelecionada == categoria,
                      selectedColor: azulClaro,
                      onSelected: (_) {
                        setState(() {
                          categoriaSelecionada = categoria;
                        });
                      },
                    ),
                  );
                }).toList(),
              ),
            ),

            const SizedBox(height: 15),

            Text(
              '${listaFiltrada.length} receita(s) encontrada(s)',
              style: const TextStyle(
                fontWeight: FontWeight.bold,
                color: azulEscuro,
              ),
            ),

            const SizedBox(height: 10),

            Expanded(
              child: listaFiltrada.isEmpty
                  ? const Center(
                child: Text(
                  'Nenhuma receita encontrada.\n'
                      'Tente outro nome ou categoria.',
                  textAlign: TextAlign.center,
                ),
              )
                  : ListView(
                children: listaFiltrada.map((receita) {
                  return CardReceita(
                    receita: receita,
                    favorito: widget.favoritos.contains(receita.nome),
                    onAbrir: () =>
                        widget.onAbrirReceita(receita),
                    onFavoritar: () =>
                        widget.onFavoritar(receita),
                  );
                }).toList(),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

