import 'package:flutter/material.dart';

void main() {
  runApp(const ReceitasApp());
}

class ReceitasApp extends StatelessWidget {
  const ReceitasApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Receitas',
      theme: ThemeData(
        colorScheme: ColorScheme.fromSeed(
          seedColor: const Color(0xFF2962A3),
        ),
        scaffoldBackgroundColor: const Color(0xFFFAF7F0),
        useMaterial3: true,
      ),
      home: const Inicio(),
    );
  }
}

// Classe Receita
class Receita {
  final String emoji;
  final String nome;
  final String tempo;
  final String dificuldade;

  const Receita({
    required this.emoji,
    required this.nome,
    required this.tempo,
    required this.dificuldade,
  });
}

// Tela inicial
class Inicio extends StatefulWidget {
  const Inicio({super.key});

  @override
  State<Inicio> createState() => _InicioState();
}

class _InicioState extends State<Inicio> {
  int categoriaSelecionada = 0;
  int paginaSelecionada = 0;

  final TextEditingController buscaController =
  TextEditingController();

  String? termoPesquisado;
  String? mensagemErro;

  final List<String> categorias = [
    'Todas',
    'Café da manhã',
    'Almoço',
    'Jantar',
    'Sobremesas',
    'Lanches',
  ];

  final List<Receita> receitas = [
    Receita(
      emoji: '🍫',
      nome: 'Brownie de chocolate',
      tempo: '45 min',
      dificuldade: 'Médio',
    ),
    Receita(
      emoji: '🥗',
      nome: 'Salada de frango',
      tempo: '20 min',
      dificuldade: 'Fácil',
    ),
    Receita(
      emoji: '🍓',
      nome: 'Vitamina de morango',
      tempo: '10 min',
      dificuldade: 'Fácil',
    ),
  ];

  // Função de pesquisa
  void pesquisarReceita() {
    final String consulta = buscaController.text.trim();

    if (consulta.isEmpty) {
      setState(() {
        termoPesquisado = null;
        mensagemErro =
        'Digite o nome de uma receita antes de pesquisar.';
      });
      return;
    }

    setState(() {
      termoPesquisado = consulta;
      mensagemErro = null;
    });
  }

  // Limpar pesquisa
  void limparPesquisa() {
    setState(() {
      buscaController.clear();
      termoPesquisado = null;
      mensagemErro = null;
    });
  }

  @override
  void dispose() {
    buscaController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        backgroundColor: const Color(0xFFFAF7F0),
        centerTitle: true,
        title: const Text(
          'Receitas',
          style: TextStyle(
            color: Color(0xFF2962A3),
            fontWeight: FontWeight.bold,
          ),
        ),
      ),

      body: SingleChildScrollView(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text(
              'Olá!',
              style: TextStyle(
                fontSize: 28,
                fontWeight: FontWeight.bold,
                color: Color(0xFF1E3550),
              ),
            ),

            const SizedBox(height: 5),

            const Text(
              'O que vamos cozinhar hoje?',
              style: TextStyle(fontSize: 16),
            ),

            const SizedBox(height: 20),

            // Campo de pesquisa
            const Text(
              'Nome da receita',
              style: TextStyle(
                fontSize: 16,
                fontWeight: FontWeight.bold,
              ),
            ),

            const SizedBox(height: 8),

            TextField(
              controller: buscaController,
              textInputAction: TextInputAction.search,
              onSubmitted: (_) => pesquisarReceita(),
              decoration: InputDecoration(
                hintText: 'Digite o nome da receita...',
                prefixIcon: const Icon(Icons.search),
                suffixIcon: IconButton(
                  icon: const Icon(Icons.close),
                  onPressed: limparPesquisa,
                  tooltip: 'Limpar pesquisa',
                ),
                filled: true,
                fillColor: Colors.white,
                border: OutlineInputBorder(
                  borderRadius: BorderRadius.circular(15),
                  borderSide: BorderSide.none,
                ),
              ),
            ),

            const SizedBox(height: 12),

            // Botão pesquisar
            SizedBox(
              width: double.infinity,
              child: ElevatedButton.icon(
                onPressed: pesquisarReceita,
                icon: const Icon(Icons.search),
                label: const Text('Pesquisar'),
                style: ElevatedButton.styleFrom(
                  backgroundColor: const Color(0xFF2962A3),
                  foregroundColor: Colors.white,
                  padding: const EdgeInsets.symmetric(
                    vertical: 14,
                  ),
                  shape: RoundedRectangleBorder(
                    borderRadius: BorderRadius.circular(12),
                  ),
                ),
              ),
            ),

            // Mensagem de erro
            if (mensagemErro != null) ...[
              const SizedBox(height: 12),

              Container(
                width: double.infinity,
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(
                  color: Colors.red.shade50,
                  borderRadius: BorderRadius.circular(12),
                ),
                child: Text(
                  mensagemErro!,
                  style: TextStyle(
                    color: Colors.red.shade800,
                    fontWeight: FontWeight.w500,
                  ),
                ),
              ),
            ],

            // Resultado da pesquisa
            if (termoPesquisado != null) ...[
              const SizedBox(height: 12),

              Container(
                width: double.infinity,
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(
                  color: const Color(0xFFD6E7FA),
                  borderRadius: BorderRadius.circular(12),
                ),
                child: Text(
                  'Pesquisa realizada com sucesso!\n'
                      'Termo pesquisado: "$termoPesquisado"',
                  style: const TextStyle(
                    color: Color(0xFF1E3550),
                    fontWeight: FontWeight.w600,
                  ),
                ),
              ),
            ],

            const SizedBox(height: 22),

            // Categorias
            const Text(
              'Categorias',
              style: TextStyle(
                fontSize: 20,
                fontWeight: FontWeight.bold,
                color: Color(0xFF1E3550),
              ),
            ),

            const SizedBox(height: 12),

            SizedBox(
              height: 42,
              child: ListView.builder(
                scrollDirection: Axis.horizontal,
                itemCount: categorias.length,
                itemBuilder: (context, index) {
                  return Padding(
                    padding: const EdgeInsets.only(right: 8),
                    child: ChoiceChip(
                      label: Text(categorias[index]),
                      selected: categoriaSelecionada == index,
                      selectedColor: const Color(0xFFD6E7FA),
                      onSelected: (selecionada) {
                        setState(() {
                          categoriaSelecionada = index;
                        });
                      },
                    ),
                  );
                },
              ),
            ),

            const SizedBox(height: 25),

            // Receita em destaque
            const Text(
              'Receita em destaque',
              style: TextStyle(
                fontSize: 20,
                fontWeight: FontWeight.bold,
                color: Color(0xFF1E3550),
              ),
            ),

            const SizedBox(height: 12),

            Container(
              width: double.infinity,
              padding: const EdgeInsets.all(20),
              decoration: BoxDecoration(
                color: const Color(0xFF2962A3),
                borderRadius: BorderRadius.circular(20),
              ),
              child: const Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    '🍝',
                    style: TextStyle(fontSize: 42),
                  ),

                  SizedBox(height: 10),

                  Text(
                    'Macarrão cremoso com frango',
                    style: TextStyle(
                      fontSize: 22,
                      fontWeight: FontWeight.bold,
                      color: Colors.white,
                    ),
                  ),

                  SizedBox(height: 8),

                  Text(
                    'Uma receita prática e deliciosa para o dia a dia!',
                    style: TextStyle(
                      fontSize: 14,
                      color: Colors.white,
                    ),
                  ),

                  SizedBox(height: 12),

                  Row(
                    children: [
                      Icon(
                        Icons.access_time,
                        color: Colors.white,
                        size: 18,
                      ),

                      SizedBox(width: 5),

                      Text(
                        '30 min',
                        style: TextStyle(color: Colors.white),
                      ),

                      SizedBox(width: 15),

                      Icon(
                        Icons.check_circle_outline,
                        color: Colors.white,
                        size: 18,
                      ),

                      SizedBox(width: 5),

                      Text(
                        'Fácil',
                        style: TextStyle(color: Colors.white),
                      ),
                    ],
                  ),
                ],
              ),
            ),

            const SizedBox(height: 25),

            // Receitas populares
            const Text(
              'Receitas populares',
              style: TextStyle(
                fontSize: 20,
                fontWeight: FontWeight.bold,
                color: Color(0xFF1E3550),
              ),
            ),

            const SizedBox(height: 12),

            ...receitas.map((receita) {
              return Card(
                color: Colors.white,
                elevation: 1,
                margin: const EdgeInsets.only(bottom: 12),
                child: ListTile(
                  leading: Text(
                    receita.emoji,
                    style: const TextStyle(fontSize: 32),
                  ),

                  title: Text(
                    receita.nome,
                    style: const TextStyle(
                      fontWeight: FontWeight.bold,
                    ),
                  ),

                  subtitle: Text(
                    '${receita.tempo} • ${receita.dificuldade}',
                  ),

                  trailing: const Icon(
                    Icons.favorite_border,
                    color: Color(0xFF2962A3),
                  ),
                ),
              );
            }),
          ],
        ),
      ),

      // Navegação inferior
      bottomNavigationBar: NavigationBar(
        selectedIndex: paginaSelecionada,
        onDestinationSelected: (index) {
          setState(() {
            paginaSelecionada = index;
          });
        },
        destinations: const [
          NavigationDestination(
            icon: Icon(Icons.home_outlined),
            selectedIcon: Icon(Icons.home),
            label: 'Início',
          ),

          NavigationDestination(
            icon: Icon(Icons.favorite_border),
            label: 'Favoritos',
          ),

          NavigationDestination(
            icon: Icon(Icons.menu_book_outlined),
            label: 'Receitas',
          ),

          NavigationDestination(
            icon: Icon(Icons.person_outline),
            label: 'Perfil',
          ),
        ],
      ),
    );
  }
}
